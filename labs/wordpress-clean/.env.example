COMPOSE_PROJECT_NAME=wordpress-clean

# Host ports
# Default 8088 / 8025 match the historical clean baseline.
# They conflict with the bind-mount development lab (.env / docker-compose.yml)
# if that stack is also publishing the same ports. Stop one stack, or change
# these (e.g. WP_PORT=8091, MAILPIT_UI_PORT=8027) before `make clean-lab-up`.
WP_PORT=8088
MAILPIT_UI_PORT=8025

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# WordPress admin (local/synthetic only — do not commit a real .env)
WP_URL=http://localhost:8088
WP_TITLE="WordPress Clean Baseline"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test
WP_LOCALE=sv_SE
WP_TIMEZONE=Europe/Stockholm
